def ai_quiz():

    header()

    print("🎯 AI QUIZ GENERATOR")
    print("-" * 78)

    topic = input("\nQuiz topic: ").strip()

    if not topic:
        return

    prompt = f"""
Create a 5-question quiz about:

{topic}

Return ONLY JSON in this format:

[
  {{
    "question": "Question",
    "options": [
      "Option 1",
      "Option 2",
      "Option 3",
      "Option 4"
    ],
    "answer": 1,
    "explanation": "Explanation"
  }}
]

answer must be the option number from 1 to 4.
"""

    print("\n⏳ Creating quiz...\n")

    raw = ask_ai(prompt)

    try:

        match = re.search(
            r"\[.*\]",
            raw,
            re.DOTALL
        )

        quiz = json.loads(match.group(0))

    except:

        print("Could not parse AI quiz.")
        print(raw)

        pause()
        return

    score = 0

    for index, q in enumerate(quiz, 1):

        print("\n" + "=" * 78)

        print(
            f"{index}. {q['question']}"
        )

        for i, option in enumerate(
            q["options"], 1
        ):

            print(
                f"{i}. {option}"
            )

        try:

            answer = int(
                input("\nYour answer: ")
            )

        except:

            answer = 0

        if answer == q["answer"]:

            print("✅ Correct!")
            score += 1
            data["correct"] += 1

        else:

            print(
                "❌ Incorrect."
            )

            print(
                "Correct:",
                q["options"][q["answer"] - 1]
            )

        data["questions"] += 1

    percentage = (
        score / len(quiz)
    ) * 100

    print("\n" + "=" * 78)
    print("🏆 QUIZ RESULT")
    print("=" * 78)

    print(
        f"Score: {score}/{len(quiz)}"
    )

    print(
        f"Percentage: {percentage:.1f}%"
    )

    data["quiz_results"].append({
        "topic": topic,
        "score": score,
        "total": len(quiz),
        "percentage": percentage,
        "date": datetime.now().isoformat()
    })

    save_data()

    pause()


