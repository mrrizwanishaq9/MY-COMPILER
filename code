# 9. PDF AI ANALYZER
# ================================================================

def pdf_analyzer():

    header()

    print("📄 AI PDF ANALYZER")
    print("-" * 78)

    uploaded = files.upload()

    if not uploaded:
        return

    filename = list(uploaded.keys())[0]

    if not filename.lower().endswith(".pdf"):

        print("❌ Please upload a PDF.")
        pause()
        return

    try:

        from pypdf import PdfReader

        reader = PdfReader(filename)

        text = ""

        for page in reader.pages:

            extracted = page.extract_text()

            if extracted:
                text += extracted + "\n"

        if not text.strip():

            print("❌ No readable text found.")
            pause()
            return

        print(
            f"✅ PDF loaded: {filename}"
        )

        print(
            f"📄 Pages: {len(reader.pages)}"
        )

        # Keep request manageable
        text_for_ai = text[:100000]

        prompt = f"""
You are an AI university study assistant.

Analyze this PDF content:

{text_for_ai}

Create:

1. Executive Summary
2. Chapter/Section-wise Summary
3. Important Definitions
4. Important Concepts
5. Exam Important Questions
6. 10 MCQs
7. Short Questions
8. Long Questions
9. Quick Revision Sheet
10. Difficult Topics students should revise

Do not invent information not present in the document.
"""

        print("\n⏳ AI is analyzing PDF...\n")

        answer = ask_ai(prompt)

        print("=" * 78)
        print("📚 PDF STUDY ANALYSIS")
        print("=" * 78)

        print(answer)

        data["notes"].append({
            "type": "PDF Analysis",
            "filename": filename,
            "date": datetime.now().isoformat(),
            "content": answer
        })

        data["history"].append(
            f"Analyzed PDF: {filename}"
        )

        save_data()

    except Exception as e:

        print("❌ PDF Error:")
        print(e)

    pause()


