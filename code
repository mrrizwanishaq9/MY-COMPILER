def study_timer():

    header()

    print("⏱️ FOCUS STUDY TIMER")
    print("-" * 78)

    try:

        minutes = int(
            input(
                "\nStudy minutes (default 25): "
            ) or 25
        )

    except:

        minutes = 25

    seconds = minutes * 60

    print("\n🚀 Study session started!")

    while seconds > 0:

        m, s = divmod(seconds, 60)

        print(
            f"\r⏳ {m:02d}:{s:02d}",
            end=""
        )

        time.sleep(1)

        seconds -= 1

    print("\n\n🎉 Session complete!")

    data["study_minutes"] += minutes

    data["history"].append(
        f"Completed {minutes}-minute study session"
    )

    save_data()

    pause()


