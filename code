def ask_ai(prompt):

    if not client:
        return (
            "⚠️ Gemini API is not connected.\n\n"
            "Please configure GEMINI_API_KEY in Colab Secrets."
        )

    try:

        response = client.models.generate_content(
            model=MODEL,
            contents=prompt
        )

        return response.text

    except Exception as e:

        return f"""
❌ Gemini API Error

{e}

Possible reasons:
• API key invalid/revoked
• Model unavailable
• API quota exceeded
• Network/API problem
"""


